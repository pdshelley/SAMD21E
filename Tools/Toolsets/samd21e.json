{
  "schemaVersion": "1.0",
  "swiftCompiler": {
    "extraCLIOptions": [
      "-Xfrontend", "-disable-stack-protector",
      "-enable-experimental-feature", "Embedded",
      "-Xcc", "-mcpu=cortex-m0plus"
    ]
  },
  "linker": {
    "extraCLIOptions": [
      "-arch", "armv6m",
      "-dead_strip",
      "-static",
      "-e", "_reset",
      "-no_zero_fill_sections",
      "-segalign", "4",
      "-pagezero_size", "0",
      "-image_base", "0x2000",
      "-segaddr", "__RESET",   "0x2000",
      "-segaddr", "__VECTORS", "0x2020",
      "-seg1addr", "0x2100",
      "-segprot", "__TEXT", "r-x", "r-x"
    ]
  }
}
